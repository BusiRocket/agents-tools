{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://busirocket.dev/schemas/guidance-reconciliation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "inputHashes",
    "shared",
    "claudeOverlay",
    "codexOverlay",
    "claudeDocument",
    "codexDocument",
    "documentation",
    "decisions",
    "warnings",
    "unresolvedLimitations"
  ],
  "properties": {
    "version": { "const": 1 },
    "inputHashes": {
      "type": "object",
      "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
    },
    "shared": { "type": "string", "minLength": 1 },
    "claudeOverlay": { "type": "string", "minLength": 1 },
    "codexOverlay": { "type": "string", "minLength": 1 },
    "claudeDocument": { "type": "string", "minLength": 1 },
    "codexDocument": { "type": "string", "minLength": 1 },
    "documentation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "url", "retrievedAt"],
        "properties": {
          "provider": { "enum": ["claude", "codex"] },
          "url": { "type": "string", "format": "uri" },
          "retrievedAt": { "type": "string", "format": "date-time" }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "source", "rationale"],
        "properties": {
          "action": { "enum": ["promoted", "preserved", "translated", "removed"] },
          "source": { "enum": ["shared", "claude", "codex", "rule"] },
          "rationale": { "type": "string", "minLength": 1 }
        }
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "unresolvedLimitations": { "type": "array", "items": { "type": "string" } }
  }
}
